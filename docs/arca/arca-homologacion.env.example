# WebFlexs / ARCA homologation read-only setup.
# Copy these names into a local secret manager or an ignored .env outside Git.
# Never place real certificate contents, private keys, Token or Sign here.

ARCA_ENABLED=false
ARCA_ENVIRONMENT=homologacion

ARCA_HOMOLOGATION_NETWORK_ENABLED=false
ARCA_HOMOLOGATION_READ_ENABLED=false
ARCA_HOMOLOGATION_EMISSION_ENABLED=false
ARCA_PRODUCTION_ENABLED=false
ARCA_WSASS_AUTHORIZATION_CONFIRMED=false
READY_ARCA_HOMOLOGACION_READONLY=false

# Official homologation endpoints. The application accepts no alternatives.
ARCA_WSAA_URL=https://wsaahomo.afip.gov.ar/ws/services/LoginCms
ARCA_WSFE_URL=https://wswhomo.afip.gov.ar/wsfev1/service.asmx
ARCA_WSFE_WSDL=https://wswhomo.afip.gov.ar/wsfev1/service.asmx?WSDL

# Confirm these non-secret identifiers in WSASS/WSFE before enabling anything.
ARCA_CREDENTIAL_ID=<LOCAL_NON_SECRET_ALIAS>
ARCA_SERVICE_ID=<IDENTIFIER_CONFIRMED_IN_WSASS>
ARCA_CUIT=<11_DIGITS>
ARCA_PTO_VTA=<HOMOLOGATION_POINT_OF_SALE>
ARCA_DEFAULT_CBTE_TIPO=<CONFIRMED_VOUCHER_TYPE_ID>

# Absolute paths outside the repository. Do not use relative paths.
ARCA_CERT_PATH=<ABSOLUTE_PATH_OUTSIDE_REPOSITORY>
ARCA_PRIVATE_KEY_PATH=<ABSOLUTE_PATH_OUTSIDE_REPOSITORY>
ARCA_EXPECTED_CERT_SHA256=

# Encrypted private keys/passphrase files are not supported in this stage.
ARCA_PRIVATE_KEY_PASSPHRASE_FILE=

ARCA_CONNECT_TIMEOUT_SECONDS=10
ARCA_READ_TIMEOUT_SECONDS=30
ARCA_TA_RENEWAL_MARGIN_SECONDS=120
ARCA_WSAA_LOCK_SECONDS=60
ARCA_WSAA_WAIT_SECONDS=5

ARCA_TLS_VERIFY=true
ARCA_REDACT_SECRETS=true
ARCA_TOKEN_CACHE_ENABLED=false

# Choose exactly one shared backend only after it is running locally.
ARCA_TOKEN_CACHE_BACKEND=
ARCA_TOKEN_CACHE_URL=
ARCA_TOKEN_CACHE_PREFIX=webflexs:arca:homo
# Redis URL form: redis://127.0.0.1:<PORT>/<DB>
# Memcached URL form: 127.0.0.1:<PORT>
# File, database, LocMem and Dummy caches are forbidden for Token/Sign.
ARCA_TOKEN_CACHE_PATH=
