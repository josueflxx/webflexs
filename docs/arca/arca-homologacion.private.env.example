# Private local template for ARCA Phase 1.1.
# Copy values manually into a private ignored environment. Never commit it.
# Do not run Django's web server with the activation flags below until the
# read-only probe receives separate user authorization.

# Public, exact allowlisted values.
ARCA_ENABLED=true
ARCA_ENVIRONMENT=homologacion
ARCA_HOMOLOGATION_NETWORK_ENABLED=true
ARCA_HOMOLOGATION_READ_ENABLED=true
ARCA_HOMOLOGATION_EMISSION_ENABLED=false
ARCA_PRODUCTION_ENABLED=false
ARCA_WSASS_AUTHORIZATION_CONFIRMED=true
READY_ARCA_HOMOLOGACION_READONLY=true
READY_ARCA_HOMOLOGACION_EMISSION=false
ARCA_TAXPAYER_READ_ENABLED=true
READY_ARCA_TAXPAYER_READONLY=true
ARCA_TLS_VERIFY=true
ARCA_REDACT_SECRETS=true

ARCA_WSAA_URL=https://wsaahomo.afip.gov.ar/ws/services/LoginCms
ARCA_WSFE_URL=https://wswhomo.afip.gov.ar/wsfev1/service.asmx
ARCA_WSFE_WSDL=https://wswhomo.afip.gov.ar/wsfev1/service.asmx?WSDL
ARCA_TAXPAYER_URL=https://awshomo.arca.gob.ar/sr-padron/webservices/personaServiceA5
ARCA_TAXPAYER_WSDL=https://awshomo.arca.gob.ar/sr-padron/webservices/personaServiceA5?WSDL
ARCA_WSFE_SERVICE_ID=wsfe
ARCA_TAXPAYER_SERVICE_ID=ws_sr_constancia_inscripcion

# Private identifiers and external local paths to complete.
ARCA_CREDENTIAL_ID=<LOCAL_NON_SECRET_ALIAS>
ARCA_CUIT=<ISSUER_CUIT_11_DIGITS>
ARCA_CERT_PATH=<ABSOLUTE_CERT_PATH_OUTSIDE_CHECKOUT>
ARCA_PRIVATE_KEY_PATH=<ABSOLUTE_KEY_PATH_OUTSIDE_CHECKOUT>
ARCA_EXPECTED_CERT_SUBJECT_CN=<EXPECTED_SUBJECT_CN>
ARCA_EXPECTED_CERT_ISSUER_CN=<EXPECTED_HOMOLOGATION_CA_CN>
ARCA_EXPECTED_CERT_SHA256=
ARCA_OPENSSL_BIN=<OPENSSL_EXECUTABLE_OR_NAME>

# Human choice from local candidates. Neither value is ARCA-verified yet.
ARCA_PTO_VTA=<CANDIDATE_POINT_OF_SALE>
ARCA_DEFAULT_CBTE_TIPO=<CANDIDATE_ARCA_VOUCHER_TYPE>

# One exact Factura A canary only. These remain blank while emission is OFF.
# Expiration must be timezone-aware and no more than two hours in the future.
ARCA_HOMOLOGATION_EMISSION_COMPANY_ID=
ARCA_HOMOLOGATION_EMISSION_POINT_OF_SALE_ID=
ARCA_HOMOLOGATION_EMISSION_DOCUMENT_ID=
ARCA_HOMOLOGATION_EMISSION_SNAPSHOT_HASH=
ARCA_HOMOLOGATION_EMISSION_APPROVED_ATTEMPT=
ARCA_HOMOLOGATION_EMISSION_APPROVAL_EXPIRES_AT=

# Shared ephemeral TA cache. Redis must already be running and reachable.
ARCA_TOKEN_CACHE_ENABLED=true
ARCA_TOKEN_CACHE_BACKEND=redis
ARCA_TOKEN_CACHE_URL=redis://127.0.0.1:6379/15
ARCA_TOKEN_CACHE_PREFIX=webflexs:arca:homo:local
ARCA_TOKEN_CACHE_PATH=

# Unsupported in this stage; must remain empty.
ARCA_PRIVATE_KEY_PASSPHRASE_FILE=

# Optional future input. Keep empty until a separate probe authorization.
ARCA_TEST_TAXPAYER_CUIT=

# Non-secret operational tuning.
ARCA_CONNECT_TIMEOUT_SECONDS=10
ARCA_READ_TIMEOUT_SECONDS=30
ARCA_TA_RENEWAL_MARGIN_SECONDS=120
ARCA_WSAA_LOCK_SECONDS=60
ARCA_WSAA_WAIT_SECONDS=5
