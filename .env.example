# FLEXS B2B Environment Configuration
# Copy this file to .env and fill in your values

# Django
DJANGO_SECRET_KEY=your-secret-key-change-this-in-production
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=flexs_project.settings.local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Feature flags (incremental rollout)
FEATURE_API_V1_ENABLED=True
FEATURE_EXTERNAL_EDITOR_ENABLED=False
FEATURE_EXTERNAL_EDITOR_WRITES=False
FEATURE_BACKGROUND_JOBS_ENABLED=False
EXTERNAL_EDITOR_SYNC_LIMIT=250
FEATURE_ADVANCED_SEARCH_ENABLED=False
FEATURE_OBSERVABILITY_ENABLED=False
FEATURE_READ_ONLY_MODE=False
CATALOGOPRO_JWT_SECRET=
ORDER_REQUIRE_PAYMENT_FOR_CONFIRMATION=False
ALERT_PREPARING_STALE_DAYS=3
ALERT_HIGH_DEBT_THRESHOLD=500000
ALERT_IMPORT_ERROR_RATE_PERCENT=30

# DRF throttling defaults
DRF_RATE_ANON=60/min
DRF_RATE_USER=240/min
DRF_RATE_API_DEFAULT=180/min
DRF_RATE_API_CATALOG=240/min
DRF_RATE_API_ADMIN=300/min

# Admin presence
ADMIN_ONLINE_WINDOW_SECONDS=300
ADMIN_IDLE_WINDOW_SECONDS=90
ADMIN_PRESENCE_TOUCH_INTERVAL_SECONDS=30
ADMIN_PRESENCE_REFRESH_SECONDS=30
ADMIN_PRESENCE_EXCLUDED_USERS=admin,admin_tester

# Background jobs (Celery + Redis)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_DEFAULT_QUEUE=flexs-default
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False

# Optional observability
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_ENVIRONMENT=production

# Database (production only)
DB_NAME=flexs_db
DB_USER=flexs_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email
# Local default: console. Production default: SMTP.
LOCAL_EMAIL_BACKEND=console
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ventas@flexs.com.ar
SERVER_EMAIL=ventas@flexs.com.ar
DJANGO_PASSWORD_RESET_TIMEOUT=86400
DJANGO_PASSWORD_RESET_WINDOW_SECONDS=3600
DJANGO_PASSWORD_RESET_MAX_REQUESTS_PER_IP=8
DJANGO_PASSWORD_RESET_MAX_REQUESTS_PER_EMAIL=4

# ARCA / WSFE. Safe default: no integration and no network calls.
# Allowed values in this stage: disabled | homologacion.
# The value production and every production endpoint are blocked in code.
ARCA_ENABLED=False
ARCA_ENVIRONMENT=disabled
ARCA_HOMOLOGATION_NETWORK_ENABLED=False
ARCA_HOMOLOGATION_READ_ENABLED=False
ARCA_HOMOLOGATION_EMISSION_ENABLED=False
ARCA_PRODUCTION_ENABLED=False
ARCA_WSASS_AUTHORIZATION_CONFIRMED=False
READY_ARCA_HOMOLOGACION_READONLY=False
ARCA_TOKEN_CACHE_ENABLED=False
ARCA_TOKEN_CACHE_BACKEND=
ARCA_TOKEN_CACHE_URL=
ARCA_TOKEN_CACHE_PREFIX=webflexs:arca:homo
ARCA_TOKEN_CACHE_PATH=
ARCA_CONNECT_TIMEOUT_SECONDS=10
ARCA_READ_TIMEOUT_SECONDS=30
ARCA_TA_RENEWAL_MARGIN_SECONDS=120
ARCA_WSAA_LOCK_SECONDS=60
ARCA_WSAA_WAIT_SECONDS=5
# See docs/arca/arca-homologacion.env.example for the complete placeholder-only
# schema. Do not add real CUITs, paths, certificate data or private keys here.
# Backend-only metadata. Do not put certificate/key contents or passwords here.
# Each entry must include credential_id, environment=homologation (internal
# model label), CUIT,
# absolute cert_path/key_path outside the repository, and optionally the
# expected public SHA-256 fingerprint. Endpoints are closed constants in code.
ARCA_CREDENTIALS_CONFIG_JSON={}

# Fiscal emission guards and retries
FISCAL_RETRY_MINUTES=10
FISCAL_MAX_AUTO_RETRIES=5
FISCAL_SUBMITTING_TIMEOUT_MINUTES=20
FISCAL_ALLOW_ZERO_IVA_ARCA=False

# ARCA numbering sync before emission: never | first | always
FISCAL_ARCA_LAST_AUTH_SYNC_POLICY=first
FISCAL_ARCA_REQUIRE_LAST_AUTH_SYNC=False

# Automatic item tax snapshot on fiscal documents
FISCAL_AUTO_ITEM_TAX_ENABLED=True
FISCAL_ITEM_TAX_CALCULATION_MODE=net
FISCAL_APPLY_TAX_TO_MANUAL_DOCS=False
# Example JSON:
# {"FA":"21","FB":"21","FC":"0","NCA":"21","NDA":"21"}
FISCAL_DOC_TYPE_DEFAULT_IVA_RATES_JSON={}
# Seguridad multiempresa y proxy
STRICT_COMPANY_ISOLATION=True
ADMIN_COMPANY_ACCESS_REQUIRE_EXPLICIT=True
# IPs o redes CIDR de proxies propios. No agregues proxies publicos.
TRUSTED_PROXY_IPS=127.0.0.1,::1
LOGIN_MAX_FAILED_ATTEMPTS_PER_IP=20
LOGIN_MAX_FAILED_ATTEMPTS_PER_ACCOUNT=10

# Backups automaticos (requiere Celery Beat activo)
BACKUP_ROOT=backups/automatic
BACKUP_RETENTION_DAYS=30
BACKUP_INCLUDE_MEDIA=True
BACKUP_SCHEDULE_HOUR=2
BACKUP_SCHEDULE_MINUTE=30

# Webhooks
WEBHOOK_ALLOW_INSECURE_URLS=False
WEBHOOK_ALLOW_PRIVATE_TARGETS=False
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_TIMEOUT_SECONDS=10
