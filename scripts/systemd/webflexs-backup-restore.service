[Unit]
Description=Verify FLEXS recovery in a disposable PostgreSQL database
After=postgresql.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/www/webflexs
EnvironmentFile=/var/www/webflexs/.env
Environment=DJANGO_SETTINGS_MODULE=flexs_project.settings.production
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/var/www/webflexs/venv/bin/python manage.py backup_restore_test --latest
Nice=10
TimeoutStartSec=3600
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/www/webflexs/backups/automatic
