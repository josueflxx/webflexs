[Unit]
Description=FLEXS backup queue and daily schedule
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/webflexs
EnvironmentFile=/var/www/webflexs/.env
Environment=DJANGO_SETTINGS_MODULE=flexs_project.settings.production
Environment=BACKUP_EXECUTION_MODE=worker
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/var/www/webflexs/venv/bin/python manage.py backup_worker
UMask=0007
Nice=10
TimeoutStartSec=3600
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/www/webflexs/backups/automatic
